{
  "name": "wikimedia-source",
  "version": "0.1.0",
  "description": "Find a freely-licensed Wikimedia image for a thing, with attribution.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "author": "William Revah",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "pretest": "npm run build",
    "test": "node --test dist/test/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.7.2"
  }
}
